# ============================================================
# Dashboard -> n8n API configuration
# ============================================================

# Endpoint used by the dashboard to retrieve opportunities
N8N_API_URL=http://n8n:5678/webhook/job-dashboard/opportunities

# Endpoint used for opportunity actions
N8N_ACTION_URL=http://n8n:5678/webhook/job-dashboard/opportunity-action

# Endpoint used to save/approve outreach drafts
N8N_OUTREACH_URL=http://n8n:5678/webhook/job-dashboard/outreach-action

# Endpoint used for follow-up actions
N8N_FOLLOWUP_URL=http://n8n:5678/webhook/job-dashboard/follow-up-action

# Endpoint used to trigger opportunity discovery
N8N_DISCOVERY_URL=http://n8n:5678/webhook/dashboard-discovery


# ============================================================
# Authentication
# ============================================================

# Shared secret used between the Streamlit dashboard
# and authenticated n8n webhook endpoints.
#
# Replace this with your own strong random value.
# Never commit the real production key.
DASHBOARD_API_KEY=replace_with_a_strong_random_value