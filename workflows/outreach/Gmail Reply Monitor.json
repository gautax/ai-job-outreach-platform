    {
      "parameters": {
        "operation": "getAll",
        "limit": 100,
        "filters": {
          "includeSpamTrash": false,
          "q": "=Search {{ $json.gmail_search }}",
          "readStatus": "both",
          "receivedAfter": "={{ $json.search_received_after }}"
        }
