        -64
      ],
      "id": "ca330c91-f002-4fb8-9620-9adf6fa40a27",
      "name": "Gmail — Search Incoming Messages",
      "webhookId": "e845a3ed-5f71-590d-b80d-a9ce00c41b3e",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const preparation =\n  $('Prepare Reply Search')\n    .first()\n    ?.json ?? {};\n\nconst clean = value =>\n  String(value ?? '').trim();\n\nconst campaigns =\n  Array.isArray(preparation.campaigns)\n    ? preparation.campaigns\n    : [];\n\nconst messages = $input\n  .all()\n  .map(item => item.json ?? {})\n  .filter(message =>\n    clean(message.id) &&\n    clean(message.threadId)\n  );\n\n\nfunction extractEmail(value) {\n  const text =\n    clean(value).toLowerCase();\n\n  const angleMatch =\n    text.match(/<([^<>@\\s]+@[^<>@\\s]+)>/);\n\n  if (angleMatch) {\n    return angleMatch[1];\n  }\n\n  const plainMatch =\n    text.match(\n      /[a-z0-9._%+-]+@[a-z0-9.-]+\\.[a-z]{2,}/i\n    );\n\n  return plainMatch\n    ? plainMatch[0].toLowerCase()\n    : '';\n}\n\n\nfunction messageTimestamp(message) {\n  const milliseconds =\n    Number(message.internalDate);\n\n  if (!Number.isFinite(milliseconds)) {\n    return 0;\n  }\n\n  return milliseconds;\n}\n\n\nconst matches = [];\n\nfor (const campaign of campaigns) {\n  const threadId =\n    clean(campaign.gmail_thread_id);\n\n  const sentTimestamp =\n    new Date(\n      campaign.sent_at\n    ).getTime();\n\n  if (\n    !threadId ||\n    !Number.isFinite(sentTimestamp)\n  ) {\n    continue;\n  }\n\n  /*\n   * Exact Gmail-thread matching is the main\n   * safeguard. Messages must also have arrived\n   * after the original outreach was sent.\n   */\n  const matchingMessages =\n    messages\n      .filter(message =>\n        clean(message.threadId) ===\n          threadId &&\n        messageTimestamp(message) >\n          sentTimestamp\n      )\n      .sort(\n        (first, second) =>\n          messageTimestamp(second) -\n          messageTimestamp(first)\n      );\n\n  if (!matchingMessages.length) {\n    continue;\n  }\n\n  /*\n   * Use the newest incoming message in the\n   * tracked thread.\n   */\n  const reply =\n    matchingMessages[0];\n\n  const detectedAt =\n    new Date().toISOString();\n\n  matches.push({\n    reply_found:\n      true,\n\n    opportunity_key:\n      clean(\n        campaign.opportunity_key\n      ),\n\n    company_name:\n      clean(\n        campaign.company_name\n      ),\n\n    position_title:\n      clean(\n        campaign.position_title\n      ),\n\n    contact_name:\n      clean(\n        campaign.contact_name\n      ),\n\n    contact_email:\n      clean(\n        campaign.contact_email\n      ),\n\n    gmail_thread_id:\n      threadId,\n\n    response_status:\n      'REPLIED',\n\n    reply_detected_at:\n      detectedAt,\n\n    reply_message_id:\n      clean(reply.id),\n\n    reply_from:\n      clean(reply.From),\n\n    reply_from_email:\n      extractEmail(reply.From),\n\n    reply_subject:\n      clean(reply.Subject),\n\n    reply_snippet:\n      clean(reply.snippet)\n        .slice(0, 1000),\n\n    reply_received_at:\n      new Date(\n        messageTimestamp(reply)\n      ).toISOString(),\n\n    last_updated:\n      detectedAt,\n  });\n}\n\n\nif (!matches.length) {\n  return [\n    {\n      json: {\n        reply_found:\n          false,\n\n        reply_count:\n          0,\n\n        monitored_campaign_count:\n          campaigns.length,\n\n        gmail_message_count:\n          messages.length,\n\n        monitor_checked_at:\n          new Date().toISOString(),\n\n        message:\n          'No replies were found in the monitored Gmail threads.',\n      },\n    },\n  ];\n}\n\n\nreturn matches.map(match => ({\n  json: {\n    ...match,\n\n    reply_count:\n      matches.length,\n\n    monitored_campaign_count:\n      campaigns.length,\n\n    gmail_message_count:\n      messages.length,\n\n    monitor_checked_at:\n      new Date().toISOString(),\n  },\n}));"
      },
