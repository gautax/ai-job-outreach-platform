      "id": "517edb45-6b55-49e7-bcde-da1e01b9a8f6",
      "name": "Load Outreach Applications"
    },
    {
      "parameters": {
        "jsCode": "const clean = value =>\n  String(value ?? '').trim();\n\nconst upper = value =>\n  clean(value).toUpperCase();\n\nconst rows = $input\n  .all()\n  .map(item => item.json ?? {})\n  .filter(\n    row => clean(row.opportunity_key)\n  );\n\nconst monitoredStatuses =\n  new Set([\n    'SENT',\n    'FOLLOW_UP_DUE',\n    'FOLLOW_UP_SENT',\n  ]);\n\nconst campaigns = [];\nconst usedThreadIds = new Set();\n\n\nfor (const row of rows) {\n  const opportunityKey =\n    clean(row.opportunity_key);\n\n  const outreachStatus =\n    upper(row.outreach_status);\n\n  const responseStatus =\n    upper(row.response_status) ||\n    'NO_RESPONSE';\n\n  const gmailThreadId =\n    clean(row.gmail_thread_id);\n\n  const sentAt =\n    clean(row.sent_at);\n\n  const replyDetectedAt =\n    clean(row.reply_detected_at);\n\n\n  if (\n    opportunityKey.startsWith('test::')\n  ) {\n    continue;\n  }\n\n  if (\n    !monitoredStatuses.has(\n      outreachStatus\n    )\n  ) {\n    continue;\n  }\n\n  if (\n    responseStatus !== 'NO_RESPONSE'\n  ) {\n    continue;\n  }\n\n  if (!gmailThreadId || !sentAt) {\n    continue;\n  }\n\n  if (replyDetectedAt) {\n    continue;\n  }\n\n  /*\n   * Avoid monitoring the same Gmail thread\n   * more than once.\n   */\n  if (\n    usedThreadIds.has(\n      gmailThreadId\n    )\n  ) {\n    continue;\n  }\n\n  const sentDate =\n    new Date(sentAt);\n\n  if (\n    Number.isNaN(\n      sentDate.getTime()\n    )\n  ) {\n    continue;\n  }\n\n  usedThreadIds.add(\n    gmailThreadId\n  );\n\n  campaigns.push({\n    opportunity_key:\n      opportunityKey,\n\n    company_name:\n      clean(row.company_name),\n\n    position_title:\n      clean(row.position_title),\n\n    contact_name:\n      clean(row.contact_name),\n\n    contact_email:\n      clean(row.contact_email)\n        .toLowerCase(),\n\n    email_subject:\n      clean(row.email_subject),\n\n    sent_at:\n      sentDate.toISOString(),\n\n    gmail_message_id:\n      clean(row.gmail_message_id),\n\n    gmail_thread_id:\n      gmailThreadId,\n\n    outreach_status:\n      outreachStatus,\n\n    response_status:\n      responseStatus,\n  });\n}\n\n\n/*\n * Search from one day before the earliest\n * monitored email to avoid timezone-boundary\n * problems.\n */\nlet searchReceivedAfter = '';\n\nif (campaigns.length) {\n  const earliestTimestamp =\n    Math.min(\n      ...campaigns.map(\n        campaign =>\n          new Date(\n            campaign.sent_at\n          ).getTime()\n      )\n    );\n\n  const searchStart =\n    new Date(\n      earliestTimestamp -\n      24 * 60 * 60 * 1000\n    );\n\n  searchReceivedAfter =\n    searchStart.toISOString();\n}\n\n\nreturn [\n  {\n    json: {\n      monitor_ready:\n        campaigns.length > 0,\n\n      campaign_count:\n        campaigns.length,\n\n      campaigns,\n\n      /*\n       * Search across Gmail, including archived\n       * messages, but exclude messages sent by us.\n       */\n      gmail_search:\n        'in:anywhere -from:me',\n\n      search_received_after:\n        searchReceivedAfter,\n\n      monitor_checked_at:\n        new Date().toISOString(),\n\n      message:\n        campaigns.length\n          ? (\n              `${campaigns.length} campaign(s) ` +\n              'ready for reply monitoring.'\n            )\n          : (\n              'No outreach campaigns currently ' +\n              'require reply monitoring.'\n            ),\n    },\n  },\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
