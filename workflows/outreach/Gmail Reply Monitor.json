      "parameters": {
        "jsCode": "const clean = value =>\n  String(value ?? '').trim();\n\nconst matcherItems =\n  $('Match Replies to Campaigns')\n    .all()\n    .map(item => item.json ?? {});\n\nconst replies =\n  matcherItems.filter(\n    item =>\n      item.reply_found === true\n  );\n\nconst checkedAt =\n  new Date().toISOString();\n\n\nif (!replies.length) {\n  const result =\n    matcherItems[0] ?? {};\n\n  return [\n    {\n      json: {\n        success: true,\n\n        monitor_status:\n          'NO_REPLIES_FOUND',\n\n        reply_count:\n          0,\n\n        monitored_campaign_count:\n          Number(\n            result.monitored_campaign_count ??\n            0\n          ),\n\n        gmail_message_count:\n          Number(\n            result.gmail_message_count ??\n            0\n          ),\n\n        message:\n          clean(result.message) ||\n          'No replies were found.',\n\n        monitor_checked_at:\n          checkedAt,\n      },\n    },\n  ];\n}\n\n\nreturn [\n  {\n    json: {\n      success: true,\n\n      monitor_status:\n        'REPLIES_UPDATED',\n\n      reply_count:\n        replies.length,\n\n      updated_opportunity_keys:\n        replies.map(\n          reply =>\n            clean(\n              reply.opportunity_key\n            )\n        ),\n\n      replies:\n        replies.map(\n          reply => ({\n            opportunity_key:\n              clean(\n                reply.opportunity_key\n              ),\n\n            company_name:\n              clean(\n                reply.company_name\n              ),\n\n            contact_name:\n              clean(\n                reply.contact_name\n              ),\n\n            reply_from:\n              clean(\n                reply.reply_from\n              ),\n\n            reply_subject:\n              clean(\n                reply.reply_subject\n              ),\n\n            reply_received_at:\n              clean(\n                reply.reply_received_at\n              ),\n          })\n        ),\n\n      message:\n        `${replies.length} campaign reply` +\n        `${replies.length === 1 ? '' : 'ies'} ` +\n        'detected and recorded.',\n\n      monitor_checked_at:\n        checkedAt,\n    },\n  },\n];"
      },
