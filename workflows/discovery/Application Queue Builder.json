    {
      "parameters": {
        "jsCode": "function toList(value) {\n  if (Array.isArray(value)) {\n    return value\n      .map(item => String(item ?? '').trim())\n      .filter(Boolean);\n  }\n\n  return String(value ?? '')\n    .split(/\\s*\\|\\s*/)\n    .map(item => item.trim())\n    .filter(Boolean);\n}\n\nfunction normalizeVacancyUrl(value) {\n  return String(value ?? '')\n    .trim()\n    .replace(/#.*$/, '')\n    .replace(/\\?.*$/, '')\n    .replace(/\\/+$/, '')\n    .toLowerCase();\n}\n\nfunction titleFromUrl(value) {\n  const url = String(value ?? '');\n\n  const lastPart =\n    url.split('/').filter(Boolean).pop() || 'Untitled position';\n\n  return lastPart\n    .replace(/[-_]+/g, ' ')\n    .replace(/\\b\\w/g, character =>\n      character.toUpperCase()\n    );\n}\n\nconst output = [];\n\nfor (const item of $input.all()) {\n  const company = item.json;\n\n  const vacancyUrls = toList(\n    company.relevant_vacancy_urls\n  );\n\n  const roleTitles = toList(\n    company.relevant_role_titles\n  );\n\n  for (\n    let index = 0;\n    index < vacancyUrls.length;\n    index++\n  ) {\n    const vacancyUrl =\n      vacancyUrls[index];\n\n    const normalizedUrl =\n      normalizeVacancyUrl(vacancyUrl);\n\n    const positionTitle =\n      roleTitles[index] ||\n      titleFromUrl(vacancyUrl);\n\n    const companyKey = String(\n      company.company_key ?? ''\n    ).trim();\n\n    if (!companyKey || !normalizedUrl) {\n      continue;\n    }\n\n    output.push({\n      json: {\n        opportunity_key:\n          `${companyKey}::${normalizedUrl}`,\n        opportunity_type:\n          'DIRECT_APPLICATION',\n\n        company_key:\n          companyKey,\n\n        company_name:\n          company.company_name || '',\n\n        company_domain:\n          company.company_domain || '',\n\n        country:\n          company.verified_company_country ||\n          company.country ||\n          '',\n\n        position_title:\n          positionTitle,\n\n        vacancy_url:\n          vacancyUrl,\n\n        qualification_score:\n          company.qualification_score || 0,\n\n        qualification_reason:\n          company.qualification_reason || '',\n\n        visa_support_status:\n          company.visa_support_status ||\n          'UNKNOWN',\n\n        careers_contact_email:\n          company.careers_contact_email || '',\n\n        outreach_angle:\n          company.outreach_angle || '',\n\n        application_status:\n          'TO_REVIEW',\n\n        applied_at:\n          '',\n\n        contact_research_status:\n          'NOT_STARTED',\n\n        contact_name:\n          '',\n\n        contact_role:\n          '',\n\n        contact_email:\n          '',\n\n        contact_linkedin_url:\n          '',\n\n        outreach_channel:\n          '',\n\n        outreach_draft:\n          '',\n\n        outreach_approval:\n          'PENDING',\n\n        outreach_status:\n          'NOT_STARTED',\n\n        sent_at:\n          '',\n\n        follow_up_date:\n          '',\n\n        response_status:\n          'NO_RESPONSE',\n\n        notes:\n          '',\n\n        last_updated:\n          new Date().toISOString(),\n      },\n    });\n  }\n}\n\nreturn output;"
      },
