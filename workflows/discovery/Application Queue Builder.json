      "name": "Keep Speculative Prospects"
    },
    {
      "parameters": {
        "jsCode": "function clean(value) {\n  return String(value ?? '').trim();\n}\n\nconst output = [];\nconst now = new Date().toISOString();\n\nfor (const item of $input.all()) {\n  const company = item.json ?? {};\n\n  const companyKey = clean(\n    company.company_key\n  ).toLowerCase();\n\n  if (!companyKey) {\n    continue;\n  }\n\n  const destinationUrl =\n    clean(company.careers_url) ||\n    clean(company.company_website);\n\n  output.push({\n    json: {\n      opportunity_key:\n        `${companyKey}::speculative`,\n\n      company_key:\n        companyKey,\n\n      company_name:\n        clean(company.company_name),\n\n      company_domain:\n        clean(company.company_domain),\n\n      country:\n        clean(\n          company.verified_company_country\n        ),\n\n      position_title:\n        'Potential AI / Data opportunities',\n\n      // For speculative prospects, this points to\n      // the careers page or company website.\n      vacancy_url:\n        destinationUrl,\n\n      qualification_score:\n        Number(\n          company.qualification_score || 0\n        ),\n\n      qualification_reason:\n        clean(company.qualification_reason),\n\n      visa_support_status:\n        clean(company.visa_support_status) ||\n        'UNKNOWN',\n\n      careers_contact_email:\n        clean(company.careers_contact_email),\n\n      outreach_angle:\n        clean(company.outreach_angle),\n\n      application_status:\n        'TO_REVIEW',\n\n      // It must remain empty until the user\n      // confirms speculative outreach.\n      outreach_mode:\n        '',\n\n      applied_at:\n        '',\n\n      contact_research_status:\n        'NOT_STARTED',\n\n      contact_name:\n        '',\n\n      contact_role:\n        '',\n\n      contact_email:\n        '',\n\n      contact_email_confidence:\n        '',\n\n      contact_linkedin_url:\n        '',\n\n      outreach_channel:\n        '',\n\n      outreach_draft:\n        '',\n\n      outreach_approval:\n        'PENDING',\n\n      outreach_status:\n        'NOT_STARTED',\n\n      sent_at:\n        '',\n\n      follow_up_date:\n        '',\n\n      response_status:\n        'NO_RESPONSE',\n\n      notes:\n        '',\n\n      last_updated:\n        now,\n\n      email_draft:\n        '',\n\n      linkedin_connection_note:\n        '',\n\n      linkedin_message:\n        '',\n\n      draft_final_status:\n        '',\n\n      draft_generated_at:\n        '',\n\n      email_subject:\n        '',\n\n      resume_file_id:\n        '',\n\n      resume_filename:\n        '',\n\n      gmail_message_id:\n        '',\n\n      gmail_thread_id:\n        '',\n\n      reply_detected_at:\n        '',\n\n      reply_message_id:\n        '',\n\n      reply_from:\n        '',\n\n      reply_subject:\n        '',\n\n      reply_snippet:\n        '',\n\n      follow_up_status:\n        '',\n\n      follow_up_draft:\n        '',\n\n      follow_up_generated_at:\n        '',\n\n      follow_up_approval:\n        '',\n\n      follow_up_approved_at:\n        '',\n\n      follow_up_sent_at:\n        '',\n\n      follow_up_message_id:\n        '',\n\n      opportunity_type:\n        'SPECULATIVE_OUTREACH',\n    },\n  });\n}\n\nreturn output;"
      },
