      "id": "0613efba-4116-4360-9672-bf97a1c3a7c3",
      "name": "Load Existing Tracker Rows",
      "executeOnce": true,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "function normalizeKey(value) {\n  return String(value ?? '')\n    .trim()\n    .toLowerCase();\n}\n\n\n// Rows already stored in Application_Tracker\nconst existingKeys = new Set(\n  $input\n    .all()\n    .map(item =>\n      normalizeKey(item.json.opportunity_key)\n    )\n    .filter(Boolean)\n);\n\n\n// Opportunities generated during this execution\nconst candidates =\n  $('Merge Opportunity Candidates').all();\n\n\n// Protect against duplicate opportunity keys\n// generated during the SAME execution.\nconst seenThisRun = new Set();\n\nconst newOpportunities = [];\n\nfor (const item of candidates) {\n  const key = normalizeKey(\n    item.json.opportunity_key\n  );\n\n  if (!key) {\n    continue;\n  }\n\n  // Already stored from a previous execution\n  if (existingKeys.has(key)) {\n    continue;\n  }\n\n  // Already accepted earlier in this execution\n  if (seenThisRun.has(key)) {\n    continue;\n  }\n\n  seenThisRun.add(key);\n\n  newOpportunities.push({\n    json: {\n      ...item.json,\n    },\n  });\n}\n\nreturn newOpportunities;"
      },
      "type": "n8n-nodes-base.code",
